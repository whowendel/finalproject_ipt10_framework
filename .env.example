# FlowForge environment configuration
# Copy this file to .env and adjust the values for your machine.
# (.env is git-ignored; this example is used as a fallback when .env is missing.)

APP_NAME="FlowForge Activity System"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# Base URL of the site. Only the path part is used when building links.
# Leave the path empty to auto-detect it, e.g. when running from an XAMPP sub-folder.
APP_URL=http://127.0.0.1:8000

# Database: sqlite (default, zero setup) or mysql
DB_DRIVER=sqlite
# DB_PATH=storage/database.sqlite   (defaults to storage/database.sqlite)

# MySQL / MariaDB settings (used when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flowforge
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=flowforge_session
SESSION_LIFETIME=7200

# LOG_PATH=storage/logs/app.log    (set to false to disable logging)

# External API: Nager.Date public holidays (no API key required)
HOLIDAY_API_URL=https://date.nager.at/api/v3
HOLIDAY_COUNTRY=PH
HOLIDAY_CACHE_TTL=86400
HOLIDAY_API_TIMEOUT=5
